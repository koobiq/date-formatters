{
    "name": "native-date-adapter",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/native-date-adapter/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/rollup:rollup",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/native-date-adapter",
                "entryFile": "packages/native-date-adapter/src/index.ts",
                "format": ["esm", "cjs"],
                "compiler": "tsc",
                "generateExportsField": true,
                "tsConfig": "packages/native-date-adapter/tsconfig.lib.json",
                "project": "packages/native-date-adapter/package.json",
                "assets": [
                    {
                        "glob": "README.md",
                        "input": ".",
                        "output": "."
                    },
                    {
                        "glob": "LICENSE",
                        "input": ".",
                        "output": "."
                    }
                ]
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "packages/native-date-adapter/jest.config.js"
            }
        }
    }
}
