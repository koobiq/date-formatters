{
    "name": "date-formatter",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/date-formatter/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/rollup:rollup",
            "outputs": ["{options.outputPath}"],
            "options": {
                "project": "packages/date-formatter/package.json",
                "outputPath": "dist/date-formatter",
                "entryFile": "packages/date-formatter/src/index.ts",
                "format": ["esm", "cjs"],
                "compiler": "tsc",
                "generateExportsField": true,
                "tsConfig": "packages/date-formatter/tsconfig.lib.json",
                "assets": [
                    {
                        "glob": "README.md",
                        "input": ".",
                        "output": "."
                    },
                    {
                        "glob": "LICENSE",
                        "input": ".",
                        "output": "."
                    }
                ]
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/jest.preset.js",
                "{workspaceRoot}/packages/internationalized-date-adapter/src/**/*",
                "{workspaceRoot}/packages/luxon-date-adapter/src/**/*",
                "{workspaceRoot}/packages/moment-date-adapter/src/**/*",
                "{workspaceRoot}/packages/native-date-adapter/src/**/*"
            ],
            "options": {
                "jestConfig": "packages/date-formatter/jest.config.js"
            }
        }
    }
}
