{
    "name": "koobiq-adapter-formatters",
    "version": "3.5.1",
    "license": "MIT",
    "scripts": {
        "build:affected": "nx affected --base=origin/main --target=build --parallel",
        "build:all": "nx run-many --target=build --all --parallel=false",
        "build:date-adapter": "nx run date-adapter:build",
        "build:date-formatter": "nx run date-formatter:build",
        "build:internationalized-date-adapter": "nx run internationalized-date-adapter:build",
        "build:luxon-date-adapter": "nx run luxon-date-adapter:build",
        "build:moment-date-adapter": "nx run moment-date-adapter:build",
        "build:native-date-adapter": "nx run native-date-adapter:build",
        "lint:all": "nx run-many --target=lint --all --parallel",
        "prepare": "husky",
        "publish:github-ci": "koobiq-cli --changelog-scope \"Date Formatters\" publish-ci-github",
        "release:stage:commit": "nx release",
        "test:all": "nx run-many --target=test --all --parallel",
        "format:check": "prettier --check packages/**/** --cache",
        "format:check:changed-files": "pretty-quick --staged --check",
        "format:write": "prettier --write packages/**/** --cache"
    },
    "release": {
        "packages": [
            "date-adapter",
            "date-formatter",
            "internationalized-date-adapter",
            "luxon-date-adapter",
            "moment-date-adapter",
            "native-date-adapter"
        ]
    },
    "overrides": {
        "@rollup/pluginutils": {
            "picomatch": "2.3.1"
        }
    },
    "dependencies": {
        "@internationalized/date": "^3.8.2",
        "@messageformat/core": "^3.3.0",
        "luxon": "^3.4.4",
        "moment": "^2.30.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
        "@koobiq/cli": "17.9.0",
        "@nrwl/eslint-plugin-nx": "19.1.1",
        "@nx/eslint": "19.1.1",
        "@nx/jest": "19.1.1",
        "@nx/js": "19.1.1",
        "@nx/rollup": "19.1.1",
        "@swc/cli": "0.3.12",
        "@swc/core": "1.3.107",
        "@swc/helpers": "0.5.7",
        "@types/jest": "29.4.4",
        "@types/luxon": "^3.4.2",
        "@types/node": "18.19.26",
        "@typescript-eslint/eslint-plugin": "8.68.0",
        "@typescript-eslint/parser": "8.68.0",
        "eslint": "10.9.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-array-func": "5.1.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-todo-plz": "1.4.0",
        "husky": "^9.1.7",
        "jest": "29.4.3",
        "jest-environment-jsdom": "^29.5.0",
        "lint-staged": "^15.5.2",
        "nx": "19.1.1",
        "prettier": "3.0.3",
        "prettier-plugin-organize-imports": "^3.2.4",
        "pretty-quick": "^4.0.0",
        "ts-jest": "29.1.2",
        "ts-node": "9.1.1",
        "tslib": "2.3.0",
        "typescript": "5.4.5"
    },
    "nx": {
        "targets": {}
    }
}
